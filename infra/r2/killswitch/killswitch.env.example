# Copy to ~/.config/postup/killswitch.env (mode 600). Do not commit the copy.
# Token + account id stay in ~/.config/postup/cloudflare.env — this file has none.

R2_BUCKET=postup-tiles

# Month-to-date Class B (GetObject/HeadObject/…) before disabling r2.dev.
# 50M ≈ 40M over the 10M free tier ≈ $14.40 at $0.36/million.
KILLSWITCH_MTD_CLASS_B=50000000

# Any UTC hour's Class B count.
KILLSWITCH_BURST_1H_CLASS_B=5000000

# 1 = never disable, still logs and would-trip.
KILLSWITCH_DRY_RUN=0

BUS_FROM=871f8f6b-c1b8-4449-b3cc-2e87896427d8
BUS_TO=f0ef8aab-ebe9-4df7-b29e-633bf2ec7164
AGENT_HUB_BUS_URL=http://127.0.0.1:3051/bus/send
KILLSWITCH_STATE_DIR=/home/main/.config/postup/killswitch
