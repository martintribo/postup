# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"
PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional: server key for Text Search place_id only (no photos).
GOOGLE_PLACES_API_KEY=
# Browser key for Maps JS / Places UI Kit. Referrer-restrict to
# https://dev-vm.burbot-fence.ts.net:* and https://postup.now/*
# Do not use a server key here.
PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
