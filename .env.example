# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# M1 sign-in (all optional; providers without keys are hidden)
PUBLIC_FF_OAUTH=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=        # Services ID, e.g. now.postup.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=      # PKCS8 .p8 contents, \n escaped
OAUTH_REDIRECT_ORIGIN=  # e.g. https://postup.now (defaults to request origin)
OAUTH_MOCK=0            # dev/test only; ignored when VERCEL_ENV=production

# M0 config
PUBLIC_LAUNCH_AREA_NAME="Westside, Los Angeles"
PUBLIC_LAUNCH_AREA_LAT=33.9765
PUBLIC_LAUNCH_AREA_LNG=-118.4176
PUBLIC_THEME=fresh
PUBLIC_FF_AGENT_API=0
PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional: server key for Text Search place_id only (no photos).
GOOGLE_PLACES_API_KEY=
# Browser key for Maps JS / Places UI Kit. Referrer-restrict to
# https://dev-vm.burbot-fence.ts.net:* and https://postup.now/*
# Do not use a server key here.
PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
PUBLIC_FF_PLACES_V2=0
PUBLIC_FF_FEED_HOME=0
PUBLIC_FF_JOIN=0
PUBLIC_FF_EMAIL_ALERTS=0
EMAIL_WEBHOOK_URL=
PUBLIC_ASK_HIDE_CAFE=1
PUBLIC_DEFAULT_JOIN_MODE=open
PUBLIC_FF_CHAT=0
PUBLIC_CHAT_READ_HOURS=24
ADMIN_USERNAMES=
PUBLIC_FF_SHARE_LINKS=0

# M10 native app
CAP_MODE=remote            # remote (ships now) | bundled (target, D7)
CAP_SERVER_URL=https://postup.now
CAP_APP_ID=now.postup.app
APPLE_BUNDLE_ID=now.postup.app
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
ANDROID_CERT_SHA256=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
