# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# M1 sign-in (all optional; providers without keys are hidden)
PUBLIC_FF_OAUTH=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=        # Services ID, e.g. now.postup.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=      # PKCS8 .p8 contents, \n escaped
OAUTH_REDIRECT_ORIGIN=  # e.g. https://postup.now (defaults to request origin)
OAUTH_MOCK=0            # dev/test only; ignored when VERCEL_ENV=production

# M0 config
PUBLIC_LAUNCH_AREA_NAME="Westside, Los Angeles"
PUBLIC_LAUNCH_AREA_LAT=33.9765
PUBLIC_LAUNCH_AREA_LNG=-118.4176
PUBLIC_THEME=fresh
