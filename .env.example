# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# Mapbox Search / geocode only — not used for map tiles.
PUBLIC_MAPBOX_ACCESS_TOKEN=""

# Protomaps PMTiles archive or z/x/y endpoint. Same-origin path is fine in Vite.
# Example: /tiles/socal.pmtiles  or  https://tiles.example.com/basemap.pmtiles
PUBLIC_TILES_URL="/tiles/socal.pmtiles"
